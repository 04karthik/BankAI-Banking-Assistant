modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/bankai-dashboard: web"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BANKAI_LLM_PROVIDER = "custom"
BANKAI_LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
BANKAI_LLM_MODEL = "gemini-3.8-flash"
BANKAI_LLM_TIMEOUT_SECONDS = "30"

